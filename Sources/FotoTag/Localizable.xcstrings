                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg photos"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@: c'era già una didascalia diversa, l'ho lasciata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: a different caption was already there, I left it"
          }
        }
      }
    },
    "%@: file illeggibile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: unreadable file"
          }
        }
      }
    },
    "%@: i RAW non si modificano, si scrive solo il .xmp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: RAW files are never changed, only the .xmp is written"
          }
        }
      }
    },
    "%@: impossibile creare il file temporaneo (cartella in sola lettura?)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: couldn't create the temporary file (read-only folder?)"
          }
        }
      }
    },
    "%@: la scrittura avrebbe cambiato l'immagine, il file non è stato modificato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: writing would have changed the image, the file was not changed"
          }
        }
      }
    },
    "%@: scrittura non riuscita %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: writing failed %@"
          }
        }
      }
    },
    "%@: sidecar esistente non leggibile, non l'ho toccato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: existing sidecar can't be read, I didn't touch it"
          }
        }
      }
    },
    "%@: verifica fallita": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: check failed"
          }
        }
      }
    },
    "%@: verifica fallita, mancano %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: check failed, missing %@"
          }
        }
      }
    },
    "%@: verifica fallita, mancano %@ e la didascalia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: check failed, missing %@ and the caption"
          }
        }
      }
    },
    "%lld": {},
    "%lld JPG: tag e didascalia dentro il file. L'immagine non viene ricompressa.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld JPG: tags and caption inside the file. The image is not recompressed."
          }
        }
      }
    },
    "%lld RAW senza JPG restano solo da vedere: per ora FotoTag analizza JPG, HEIC e TIFF. Esporta un JPG per analizzarli.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld RAW files without a JPG can only be viewed: for now FotoTag analyzes JPG, HEIC and TIFF. Export a JPG to analyze them."
          }
        }
      }
    },
    "%lld analizzate · %lld da rivedere · %lld confermate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld analyzed · %lld to review · %lld confirmed"
