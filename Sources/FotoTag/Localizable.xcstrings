        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where to save photo previews (the ones already saved stay where they are)."
          }
        }
      }
    },
    "Dove si trova ora «%@»? Analisi, revisione e tag restano collegati alle foto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where is “%@” now? Analysis, review and tags stay linked to the photos."
          }
