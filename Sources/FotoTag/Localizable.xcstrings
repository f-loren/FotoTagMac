    " (copia)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " copy"
          }
        }
      }
    },
    " (disco in cloud)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (cloud drive)"
          }
        }
      }
    },
    " (importato)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (imported)"
          }
        }
      }
    },
    " Chiudi e riapri FotoTag, poi riprova.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Quit and reopen FotoTag, then try again."
          }
        }
      }
    },
    " Occupa 1,5 GB sul disco.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Uses 1.5 GB of disk space."
          }
        }
      }
    },
    " · circa %lld h": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · about %lld h left"
          }
        }
      }
    },
    " · circa %lld min": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · about %lld min left"
          }
        }
      }
    },
    " · meno di 2 min": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · under 2 min left"
          }
        }
      }
    },
    "%@ RAW del disco in cloud non sono ancora collegabili ai JPG.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ RAW files on your cloud drive can't be matched to their JPGs yet."
          }
        }
      }
    },
    "%@ foto del disco in cloud non sono cercabili.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ photos on your cloud drive aren't searchable yet."
          }
        }
      }
    },
    "%@ in tutte le cartelle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ across all folders"
          }
        }
      }
    },
    "%@ non è ancora stata scaricata dal disco in cloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't downloaded from your cloud drive yet"
          }
        }
      }
    },
    "%@ non è ancora stata scaricata dal disco in cloud: non è stata modificata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't downloaded from your cloud drive yet, so it wasn't changed"
          }
        }
      }
    },
    "%@: analisi finita": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Analysis Complete"
          }
        }
      }
    },
    "%@: analisi interrotta dopo %lld foto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: Analysis stopped after %2$#@a1@"
          },
          "substitutions": {
            "a1": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg photo"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg photos"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@: c'era già una didascalia diversa, l'ho lasciata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: kept the existing caption, which was different"
          }
        }
      }
    },
    "%@: file illeggibile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: can't read the file"
          }
        }
      }
    },
    "%@: i RAW non si modificano, si scrive solo il .xmp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: RAW files are never modified; only the .xmp sidecar is written"
          }
        }
      }
    },
    "%@: impossibile creare il file temporaneo (cartella in sola lettura?)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: couldn't create a temporary file (is the folder read-only?)"
          }
        }
      }
    },
    "%@: la scrittura avrebbe cambiato l'immagine, il file non è stato modificato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: writing would have altered the image, so the file was left unchanged"
          }
        }
      }
    },
    "%@: scrittura non riuscita %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: couldn't write %@"
          }
        }
      }
    },
    "%@: sidecar esistente non leggibile, non l'ho toccato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: can't read the existing sidecar, so it was left alone"
          }
        }
      }
    },
    "%@: verifica fallita": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verification failed"
          }
        }
      }
    },
    "%@: verifica fallita, mancano %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verification failed, missing %@"
          }
        }
      }
    },
    "%@: verifica fallita, mancano %@ e la didascalia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verification failed, missing %@ and the caption"
          }
        }
      }
    },
    "%lld": {},
    "%lld JPG: tag e didascalia dentro il file. L'immagine non viene ricompressa.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@a1@ tags and captions inside the file, without recompressing the image."
          },
          "substitutions": {
            "a1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg JPG gets"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg JPGs get"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld RAW senza JPG restano solo da vedere: per ora FotoTag analizza JPG, HEIC e TIFF. Esporta un JPG per analizzarli.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld RAW files have no JPG, so they can only be viewed. FotoTag currently analyzes JPG, HEIC, and TIFF; export JPGs to analyze them."
          }
        }
      }
    },
    "%lld analizzate · %lld da rivedere · %lld confermate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
