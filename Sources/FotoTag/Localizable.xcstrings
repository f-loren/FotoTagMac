        }
      }
    },
    "Il modello %@ non è ancora sul Mac. Scaricalo in FotoTag ▸ Impostazioni ▸ Modelli (%.1f GB, una volta sola).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't on this Mac yet. Download it once in FotoTag ▸ Settings ▸ Models (%.1f GB)."
          }
        }
      }
    },
    "Il nome della cartella della foto diventa un tag (la data viene dallo scatto)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use each photo's folder name as a tag (date from EXIF)"
          }
        }
      }
    },
    "Il numero indica in quante foto compare; × lo toglie da tutte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number shows how many photos have the tag. × removes it from all of them."
