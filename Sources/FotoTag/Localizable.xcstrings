    "%lld originali collegati con poca certezza non ricevono nulla: controllali nella revisione.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@a1@ linked with low certainty get nothing: check them in the review."
          },
          "substitutions": {
