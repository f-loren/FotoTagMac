          "stringUnit": {
            "state": "translated",
            "value": " (imported)"
          }
        }
      }
    },
    " Chiudi e riapri FotoTag, poi riprova.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Quit and reopen FotoTag, then try again."
          }
        }
      }
    },
    " Occupa 1,5 GB sul disco.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Takes 1.5 GB on disk."
          }
        }
      }
    },
    " · circa %lld h": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · about %lld h"
          }
        }
      }
    },
    " · circa %lld min": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · about %lld min"
          }
        }
      }
    },
    " · meno di 2 min": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · less than 2 min"
          }
        }
      }
    },
    "%@ RAW del disco in cloud non sono ancora collegabili ai JPG.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ RAW files on the cloud drive can't be linked to their JPGs yet."
          }
        }
      }
    },
    "%@ foto del disco in cloud non sono cercabili.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ photos on the cloud drive can't be searched."
          }
        }
      }
    },
    "%@ in tutte le cartelle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in all folders"
          }
        }
      }
    },
    "%@ non è ancora stata scaricata dal disco in cloud": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't been downloaded from the cloud drive yet"
          }
        }
      }
    },
    "%@ non è ancora stata scaricata dal disco in cloud: non è stata modificata": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hasn't been downloaded from the cloud drive yet: it was not changed"
          }
        }
      }
    },
    "%@: analisi finita": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: analysis finished"
          }
        }
      }
    },
    "%@: analisi interrotta dopo %lld foto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: analysis stopped after %2$#@a1@"
          },
          "substitutions": {
            "a1": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
