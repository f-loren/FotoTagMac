    "Finito il download parte l'analisi della foto scelta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the download finishes, the chosen photo is analyzed."
          }
        }
      }
    },
    "Finito il download parte l'analisi di %lld foto. L'avanzamento si vede in fondo alla barra laterale.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the download finishes, %1$#@a1@ analyzed. Progress shows at the bottom of the sidebar."
          },
          "substitutions": {
            "a1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
