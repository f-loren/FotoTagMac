    "Ferma il download: i file già scaricati restano e la prossima volta si riparte da lì": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the download: files already downloaded stay, and next time it resumes from there"
          }
        }
      }
    },
    "File .xmp accanto ai RAW": {
      "localizations": {
        "en": {
