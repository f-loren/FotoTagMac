      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About FotoTag"
          }
        }
      }
    },
    "L'originale non è arrivato dal disco in cloud: riprova più tardi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original didn't arrive from the cloud drive: try again later."
          }
        }
      }
    },
    "La cartella e le sue sottocartelle non contengono foto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder and its subfolders contain no photos."
          }
        }
      }
    },
    "La cartella indica la digitalizzazione (%@), non lo scatto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder gives the digitization date (%@), not the shot."
          }
        }
      }
    },
    "Lato lungo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long Side"
          }
        }
      }
    },
    "Le cartelle che lo usano tornano a Generico. Reimportandolo dal file tornano a questo profilo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders that use it go back to Generic. Importing it again from the file brings them back to this profile."
          }
        }
      }
    },
    "Le foto confermate sono già scritte nei file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmed photos are already written to the files."
          }
        }
      }
    },
    "Le parole chiave già presenti nei file restano.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keywords already in the files stay."
